<color-picker>
  <div class="selector-accent">
    <input
      type="color"
      value="#29a35c"
      class="color-picker-accent"
      data-colorpicker
    />
    <button
      class="reset-color"
      aria-label="Restablecer color de acento"
      title="Restablecer"
      data-resetcolor
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        class="icon icon-tabler icons-tabler-outline icon-tabler-rotate-clockwise"
        viewBox="0 0 24 24"
        ><path fill="none" stroke="none" d="M0 0h24v24H0z"></path><path
          d="M4.05 11a8 8 0 1 1 .5 4m-.5 5v-5h5"></path></svg
      >
    </button>
  </div>
</color-picker>

<style>
  input {
    --size: 40px;

    width: var(--size);
    height: var(--size);
    border-radius: 100%;
    background-color: transparent;
    border: none;
    cursor: pointer;
  }

  .reset-color {
    background-color: transparent;
    border: none;
    cursor: pointer;

    &:active {
      scale: 0.95;
    }
  }
</style>

<script>
  const root = document.documentElement

  class ColorPicker extends HTMLElement {
    constructor() {
      super()
      this.attachShadow({ mode: 'open' })
    }

    connectedCallback() {
      this.render()
      this.init()
    }

    render() {
      this.shadowRoot?.setHTMLUnsafe(/*html*/ `
            <slot></slot>
        `)
    }

    init() {
      const pickerColorAccent = this.querySelector('[data-colorpicker]')
      const initColor = pickerColorAccent?.getAttribute('value') || '#000'

      if (pickerColorAccent instanceof HTMLInputElement) {
        let { customProperty } = pickerColorAccent.dataset

        if (customProperty == null || customProperty === '') {
          customProperty = '--clrp-accent'
        }

        pickerColorAccent.addEventListener(
          'input',
          e => {
            if (e.target instanceof HTMLInputElement) {
              pickerColorAccent.setAttribute('value', e.target.value)
              root.style.setProperty(`${customProperty}`, e.target.value)
            }
          },
          { passive: true },
        )

        const resetColor = this.querySelector('[data-resetcolor]')

        resetColor?.addEventListener(
          'click',
          () => {
            pickerColorAccent.setAttribute('value', initColor)
            pickerColorAccent.value = initColor
            root.style.removeProperty(`${customProperty}`)
          },
          { passive: true },
        )
      }
    }
  }

  customElements.define('color-picker', ColorPicker)
</script>
