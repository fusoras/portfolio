---
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<color-picker data-custom-property="--clrp-accent">
  <div class="selector-accent">
    <input
      type="color"
      value="#29a35c"
      class="color-picker-accent"
      data-colorpicker
      aria-label={locate.COLOR_ACCENT_ARIA}
      title={locate.COLOR_ACCENT_TITLE}
    />
    <button
      class="reset-color"
      aria-label={locate.COLOR_RESET_ARIA}
      title={locate.COLOR_RESET_TITLE}
      data-resetcolor
    >
      <svg width="24" height="24">
        <use href="/assets/icons/buttons.svg#reset"></use>
      </svg>
    </button>
  </div>
</color-picker>
<style>
  .selector-accent {
    display: flex;
    align-items: center;
    gap: 12px;
    transition: translate calc(var(--left-to-right-animation-duration) + 80ms)
      ease-in-out;

    @starting-style {
      translate: var(--left-to-right-animation);
    }
  }

  input {
    --size: 40px;

    width: var(--size);
    height: var(--size);
    border-radius: 100%;
    background-color: transparent;
    border: none;
    cursor: pointer;
  }

  .reset-color {
    background-color: transparent;
    border: none;
    color: color-mix(in srgb, var(--fg), transparent);
    cursor: initial;

    &:active {
      scale: 0.95;
    }
  }

  color-picker.has-color .reset-color {
    color: var(--fg);
    cursor: pointer;
  }
</style>
<script src="@/scripts/color-picker.js"></script>
