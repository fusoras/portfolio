---
import IconCopy from '@/components/icons/IconCopy.astro'
import IconMail from '@/components/icons/IconMail.astro'
const mailText = 'developer.fusoras@gmail.com'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<label class="mail" translate="no">
  <IconMail />
  <p>
    {mailText}
  </p>
  <button class="btn-copy" title={locate.BTN_COPY}>
    <IconCopy />
  </button>
</label>
<style>
  .mail {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-left: 0.2rem;
    cursor: pointer;

    & p {
      margin: 0;
      font-size: 1rem;
    }

    & svg {
      color: var(--clr-text-primary);
      width: 25px;
      height: 25px;
    }
  }

  .btn-copy {
    padding: 6px 5px;
    background-color: light-dark(#cfcfcf, #4d4d4d);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition:
      background-color,
      scale 0.1s ease;

    &:active,
    .mail:active & {
      background-color: var(--accent);
      scale: 0.9;
    }

    & svg {
      color: var(--clr-text-primary);
      height: 15px;
      width: 15px;
    }
  }
</style>

<script>
  const btnCopy = document.querySelector('.btn-copy')
  const textElement = document.querySelector('.mail')

  btnCopy?.addEventListener('click', async () => {
    try {
      if (textElement)
        await navigator.clipboard.writeText(textElement.textContent)
    } catch (err) {
      console.error('Copy error:', err)
    }
  })
</script>
