---
import IconCopy from '@/components/icons/IconCopy.astro'
import IconMail from '@/components/icons/IconMail.astro'
const mailText = 'developer.fusoras@gmail.com'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<label class="mail" translate="no">
  <IconMail />
  <p>
    {mailText}
  </p>
  <button class="btn-copy" title={locate.BTN_COPY}>
    <IconCopy />
  </button>
  <span class="copy-tooltip" role="status">{locate.BTN_COPIED}</span>
</label>
<style>
  .mail {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    margin-left: 0.2rem;
    cursor: pointer;

    & p {
      margin: 0;
      font-size: 1rem;
    }

    & svg {
      color: var(--clr-text-primary);
      width: 25px;
      height: 25px;
    }
  }

  .copy-tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 12px;
    padding: 0.3rem 0.6rem;
    background-color: light-dark(#e6e6e6, #3d3d3d);
    color: var(--clr-text-primary);
    border-radius: 6px;
    font-size: 0.8rem;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgb(0 0 0 / 25%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.15s ease,
      visibility 0.15s ease,
      translate 0.25s ease;

    &.show {
      opacity: 1;
      visibility: visible;
      translate: -50% 0;
    }
  }

  .btn-copy {
    padding: 5px 4px;
    background-color: light-dark(#cfcfcf, #4d4d4d);
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition:
      background-color,
      scale 0.1s ease;

    &:active {
      background-color: var(--accent);
      scale: 0.9;
    }

    & svg {
      --size: 18px;

      color: var(--clr-text-primary);
      height: var(--size);
      width: var(--size);
    }
  }
</style>

<script>
  const btnCopy = document.querySelector('.btn-copy')
  const textElement = document.querySelector('.mail')
  const tooltip = document.querySelector('.copy-tooltip')
  let hideTimer

  btnCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(
        textElement?.querySelector('p')?.textContent.trim() ?? '',
      )
    } catch (err) {
      console.error('Copy error:', err)
      return
    }

    if (!tooltip) return
    tooltip.classList.add('show')
    clearTimeout(hideTimer)
    hideTimer = setTimeout(() => tooltip.classList.remove('show'), 1000)
  })
</script>
