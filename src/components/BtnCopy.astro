---
import IconCopy from '@/components/icons/IconCopy.astro'
import IconMail from '@/components/icons/IconMail.astro'
const mailText = 'developer.fusoras@gmail.com'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<label class="mail" translate="no" title={locate.BTN_COPY}>
  <IconMail />
  <p>
    {mailText}
  </p>
  <button class="btn-copy">
    <IconCopy />
  </button>
  <span class="copy-tooltip" role="status">{locate.BTN_COPIED}</span>
</label>
<style>
  .mail {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
    margin-left: 0.2rem;
    cursor: pointer;

    @media (width <= 400px) {
      flex-direction: column;
    }

    & p {
      margin: 0;
    }

    & svg {
      color: var(--fg);
      width: var(--icon-md);
      height: var(--icon-md);
    }
  }

  .copy-tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 12px;
    padding: 0.3rem 0.6rem;
    background-color: light-dark(#e6e6e6, #3d3d3d);
    color: var(--fg);
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    white-space: nowrap;
    box-shadow: 0 2px 6px rgb(0 0 0 / 25%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) ease,
      visibility var(--duration-fast) ease,
      translate 0.25s ease;

    &.show {
      opacity: 1;
      visibility: visible;
      translate: -50% 0;
    }
  }

  .btn-copy {
    --size: 30px;

    height: var(--size);
    width: var(--size);
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    padding: 5px;
    background-color: var(--bg);
    border: var(--border-default);
    border-radius: 5px;
    cursor: pointer;
    transition:
      background-color,
      scale var(--duration-fast) ease;

    &:active {
      background-color: var(--accent);
      scale: 0.9;
    }

    & svg {
      color: color-mix(in srgb, var(--fg) 60%, transparent);
      height: var(--icon-sm);
      width: var(--icon-sm);
      transition: color var(--duration-fast);
    }

    &:hover {
      & svg {
        color: var(--fg);
      }
    }
  }
</style>

<script>
  import { $ } from '@/lib/dom.ts'

  const $btnCopy = $('.btn-copy')
  const $textElement = $('.mail')
  const $tooltip = $('.copy-tooltip')
  let hideTimer

  $btnCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(
        $textElement?.querySelector('p')?.textContent.trim() ?? '',
      )
    } catch (err) {
      console.error('Copy error:', err)
      return
    }

    if (!$tooltip) return
    $tooltip.classList.add('show')
    clearTimeout(hideTimer)
    hideTimer = setTimeout(() => $tooltip.classList.remove('show'), 1000)
  })
</script>
