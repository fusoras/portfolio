---
import CardTech from '@/components/CardTech.astro'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })

const icons = ['Antigravity-CLI', 'OpenCode', 'llama.cpp', 'Linux', 'Debian', 'Podman', 'Ollama', 'Git', 'GitHub', 'NodeJS']
---

<h2>{locate.OTHER_TECH_TITLE}</h2>

<div class="tech-card-container">
  {
    icons.map(item => (
      <CardTech title={item}>
        <svg>
          <use href={`/assets/icons/tech.svg#${item.toLowerCase()}`} />
        </svg>
      </CardTech>
    ))
  }
</div>

<style>
  h2 {
    margin-bottom: var(--space-2xl);
  }

  .tech-card-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    justify-items: center;
    gap: var(--space-md);
  }

  svg {
    height: 100%;
    width: 100%;
  }
</style>
