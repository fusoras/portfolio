---
const { href } = Astro.props
---

<a class="btn-a" {href} rel="noreferrer noopener" target="_blank">
  <slot />
</a>

<style is:global>
  .btn-a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    font-weight: bold;
    border: 2px solid light-dark(var(--accent-dark), #fff);
    padding: var(--space-sm);
    border-radius: var(--radius-tile);
    gap: var(--space-sm);
    max-height: 2.5rem;
    transition: background-color var(--duration-base) ease-in-out;
  }

  .btn-a:hover {
    background-color: var(--accent);
  }
</style>
