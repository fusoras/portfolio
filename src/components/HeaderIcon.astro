---
const { href } = Astro.props
---

<a class="btn-a" {href} rel="noreferrer noopener" target="_blank">
  <slot />
</a>

<style is:global>
  .btn-a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    font-weight: bold;
    border: 2px solid light-dark(var(--accent-dark), #fff);
    padding: 10px;
    border-radius: 8px;
    gap: 0.5rem;
    max-height: 2.5rem;
    transition: background-color 0.3s ease-in-out;
  }

  .btn-a:hover {
    background-color: var(--accent-dark);
  }
</style>
