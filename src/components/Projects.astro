---
import CardProject from '@/components/CardProject.astro'
import demoPT from '@/assets/proyecto-titulacion-bg.webp'
import fitBg from '@/assets/fit-bg.webp'
import demoPTAvif from '@/assets/proyecto-titulacion-bg.avif'
import fitBgAvif from '@/assets/fit.avif'
import { ROUTES } from '@/config.ts'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<h2>{locate.PROJECTS_TITLE}</h2>

<div class="container-projects">
  <CardProject
    linkWeb={`${ROUTES.GITHUB_PAGES}/birthday-26`}
    linkRepo={`${ROUTES.REPOSITORY}/birthday-26`}
  >
    <video
      slot="cover"
      autoplay
      muted
      loop
      poster="/imgs/happy-birthday.avif"
      class="ar-main-cover"
      title={locate.PROJECTS.HAPPY_BIRTHDAY_TITLE}
    >
      <source src="/videos/hb-av1.mp4" type="video/mp4" />
      <source src="/videos/hb-h264.mp4" type="video/mp4" />
    </video>
    <h3>{locate.PROJECTS.HAPPY_BIRTHDAY_TITLE}</h3>
    <div class="container-icons">
      <svg width="24" height="24" role="img" aria-label="Astro">
        <title>Astro</title>
        <use href="/assets/icons/languages.svg#astro"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="TypeScript">
        <title>TypeScript</title>
        <use href="/assets/icons/languages.svg#typescript"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="Tailwind CSS">
        <title>Tailwind CSS</title>
        <use href="/assets/icons/languages.svg#tailwind"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="Svelte">
        <title>Svelte</title>
        <use href="/assets/icons/languages.svg#svelte"></use>
      </svg>
    </div>
    <p>
      {locate.PROJECTS.HAPPY_BIRTHDAY_DESCRIPTION}
    </p>
  </CardProject>
  <CardProject linkYt="https://youtu.be/U_7Vx_W1v9k">
    <picture slot="cover">
      <source srcset={demoPTAvif.src} type="image/avif" />
      <source srcset={demoPT.src} type="image/webp" />
      <img
        src={demoPT.src}
        alt="Proyecto de titulación mostrando interfaz inclusiva con modo oscuro y controles de accesibilidad"
        class="ar-main-cover"
        title={locate.PROJECTS.DEGREE_TITLE}
      />
    </picture>
    <h3>{locate.PROJECTS.DEGREE_TITLE}</h3>
    <div class="container-icons">
      <svg width="24" height="24" role="img" aria-label="HTML">
        <title>HTML</title>
        <use href="/assets/icons/languages.svg#html"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="CSS">
        <title>CSS</title>
        <use href="/assets/icons/languages.svg#css"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="OpenRouter">
        <title>OpenRouter</title>
        <use href="/assets/icons/languages.svg#open-router"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="Firebase">
        <title>Firebase</title>
        <use href="/assets/icons/languages.svg#firebase"></use>
      </svg>
    </div>
    <p>
      {locate.PROJECTS.DEGREE_DESCRIPTION}
    </p>
  </CardProject>
  <CardProject
    linkWeb={`${ROUTES.GITHUB_PAGES}/page-fake1/`}
    linkRepo={`${ROUTES.REPOSITORY}/page-fake1`}
  >
    <picture slot="cover">
      <source srcset={fitBgAvif.src} type="image/avif" />
      <source srcset={fitBg.src} type="image/webp" />
      <img
        src={fitBg.src}
        alt="FitZone Gym mostrando diseño responsivo y estilo moderno"
        class="ar-main-cover"
        title="FitZone Gym"
      />
    </picture>
    <h3>FitZone Gym</h3>
    <div class="container-icons">
      <svg width="24" height="24" role="img" aria-label="HTML">
        <title>HTML</title>
        <use href="/assets/icons/languages.svg#html"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="CSS">
        <title>CSS</title>
        <use href="/assets/icons/languages.svg#css"></use>
      </svg>
      <svg width="24" height="24" role="img" aria-label="Web Components">
        <title>Web Components</title>
        <use href="/assets/icons/languages.svg#web-components"></use>
      </svg>
    </div>

    <p>
      {locate.PROJECTS.FITZONE_GYM_DESCRIPTION}
    </p>
  </CardProject>
</div>
<style>
  .container-projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-lg);

    @media (width <= 700px) {
      gap: var(--space-2xl);
    }

    & h3 {
      text-align: center;
      color: var(--accent);
      font-weight: bold;
      font-family: Hammersmith, sans-serif;
    }

    & p {
      justify-self: center;
      margin: var(--space-md) 0 var(--space-2xl);
    }

    & .ar-main-cover {
      display: block;
      height: 200px;
      width: 100%;
      margin: auto;
      object-fit: cover;
      aspect-ratio: 16 / 9;
    }

    & .container-icons {
      display: flex;
      gap: var(--space-sm);

      & svg {
        height: var(--icon-md);
        width: var(--icon-md);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-md);
        border: var(--border-default);
        background-color: var(--muted);
        padding: var(--space-sm);
        border-radius: var(--radius-tile);
      }
    }
  }
</style>
