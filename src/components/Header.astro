---
import HeaderIcon from '@/components/HeaderIcon.astro'
import IconLinkedin from '@/components/icons/IconLinkedin.astro'
import IconGithub from '@/components/icons/IconGithub.astro'
import BtnCopy from '@/components/BtnCopy.astro'
import { ROUTES } from '@/config.ts'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<header>
  <h1 translate="no">{locate.HEADER_TITLE}</h1>
  <p>
    {locate.HEADER_PARAGRAPH_1}
  </p>
</header>
<section class="sc-btn">
  <HeaderIcon href="https://www.linkedin.com/in/fusoras">
    <IconLinkedin />
    Linkedin
  </HeaderIcon>
  <HeaderIcon href={ROUTES.REPOSITORY}>
    <IconGithub />
    Github
  </HeaderIcon>
</section>

<section class="sc-mail">
  <BtnCopy />
</section>
<style>
  h1 {
    --accent-lighter: light-dark(
      hsl(145deg 90% 37.06%),
      hsl(144.83deg 65.24% 56.18%)
    );

    text-align: center;
    font-weight: bold;
    background-image: linear-gradient(to right, var(--accent-lighter));
    color: transparent;
    background-clip: text;
  }

  p {
    width: min(500px, 90%);
    text-wrap: pretty;
    margin: auto;
    margin-bottom: 32px;
  }

.sc-btn {
  display: flex;
  justify-content: center;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;

  & svg {
    color: var(--fg);
    width: 22px;
    height: 22px;
    aspect-ratio: 1 / 1;
  }
}

.sc-mail {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20px;
}
</style>
