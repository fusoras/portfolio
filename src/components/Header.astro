---
import HeaderIcon from '@/components/HeaderIcon.astro'
import IconLinkedin from '@/components/icons/IconLinkedin.astro'
import IconGithub from '@/components/icons/IconGithub.astro'
import BtnCopy from '@/components/BtnCopy.astro'
import { ROUTES } from '@/config.ts'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<header>
  <h1 translate="no">{locate.HEADER_TITLE}</h1>
  <p>
    {locate.HEADER_PARAGRAPH_1}
  </p>
</header>
<section class="sc-btn">
  <HeaderIcon href="https://www.linkedin.com/in/fusoras">
    <IconLinkedin />
    Linkedin
  </HeaderIcon>
  <HeaderIcon href={ROUTES.REPOSITORY}>
    <IconGithub />
    Github
  </HeaderIcon>
</section>

<section class="sc-mail">
  <BtnCopy />
</section>
<style>
  h1 {
    text-align: center;
    font-weight: bold;
    background-image: linear-gradient(to right, var(--accent));
    color: transparent;
    background-clip: text;
  }

  p {
    width: min(500px, 90%);
    margin: auto;
    margin-bottom: var(--space-2xl);
  }

  .sc-btn {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    align-items: center;
    flex-wrap: wrap;

    & svg {
      color: var(--fg);
      width: var(--icon-md);
      height: var(--icon-md);
      aspect-ratio: 1 / 1;
    }
  }

  .sc-mail {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }
</style>
