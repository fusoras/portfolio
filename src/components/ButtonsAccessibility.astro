---
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<buttons-accessibility>
  <button
    data-a11y-action="increase-text"
    aria-label={locate.A11Y_INCREASE_TEXT_ARIA}
    title={locate.A11Y_INCREASE_TEXT_ARIA}
  >
    <svg width="24" height="24">
      <use href="/assets/icons/buttons.svg#plus"></use>
    </svg></button
  >
  <button
    data-a11y-action="decrease-text"
    aria-label={locate.A11Y_DECREASE_TEXT_ARIA}
    title={locate.A11Y_DECREASE_TEXT_ARIA}
  >
    <svg width="24" height="24">
      <use href="/assets/icons/buttons.svg#minus"></use>
    </svg></button
  >
  <button
    data-a11y-action="restore-text"
    class="restore-text"
    aria-label={locate.A11Y_RESTORE_TEXT_ARIA}
    title={locate.A11Y_RESTORE_TEXT_ARIA}
  >
    <svg width="24" height="24">
      <use href="/assets/icons/buttons.svg#reset"></use>
    </svg>
  </button>
</buttons-accessibility>

<style>
  buttons-accessibility {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;

    & button {
      display: flex;
      flex-wrap: wrap;
      place-content: center;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      height: 30px;
      width: 30px;
      border-radius: 50%;
      transition: background-color var(--duration-fast);

      &:hover {
        background-color: color-mix(in srgb, var(--fg) 8%, transparent);
      }

      &:active {
        scale: 0.95;
      }
    }

    & .restore-text {
      cursor: initial;
      color: color-mix(in srgb, var(--fg), transparent);
    }
  }

  :root[style*='--root-font-size'] .restore-text {
    cursor: pointer;
    color: var(--fig);
  }
</style>

<script src="@/scripts/buttons-accessibility.js"></script>
