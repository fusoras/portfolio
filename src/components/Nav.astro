---
const { currentLocale } = Astro
import { getI18N } from '@/i18n/index.ts'
const locate = getI18N({ currentLocale })

import ToggleTheme from '@/components/ToggleTheme.astro'
---

<nav>
  <div class="nav-items">
    <a class="active" href="#home">{locate.NAV_HOME}</a>
    <a href="#experience">{locate.NAV_EXPERIENCE}</a>
    <a href="#projects">{locate.NAV_PROJECTS}</a>
    <div class="line"></div>
    <div class="toggle-wrap">
      <ToggleTheme />
    </div>
  </div>
</nav>
<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    width: 100%;

    @media (pointer: coarse) {
      /* On touch devices, sticky can interfere with the ThemeToggle animation. */
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
    }

    & .nav-items {
      background-color: var(--bg);
      display: flex;
      place-items: center;
      place-content: center;
      flex-wrap: wrap;
      gap: var(--space-md);
      width: fit-content;
      padding: 12px var(--space-lg);
      border-radius: var(--radius-card) 3px;
      border-bottom: 2px solid transparent;
      border-right: 2px solid transparent;
      font-size: var(--text-md);
      font-weight: bold;
      animation: animate-header linear both;
      animation-timeline: scroll(root);
      animation-range: 0 200px;

      & a {
        transition: color var(--duration-fast) ease-in-out;
      }

      & .active,
      a:hover {
        color: var(--accent);
      }

      & .line {
        height: 30px;
        width: 2px;
        background-color: var(--border);
        border-radius: 2px;
      }

      @media (width <= 430px) {
        .toggle-wrap {
          display: none;
        }

        .line {
          display: none;
        }
      }
    }
  }

  @keyframes animate-header {
    to {
      background-color: color-mix(in srgb, var(--bg), transparent 40%);
      backdrop-filter: blur(4px);
      border-radius: 0 3px var(--radius-card);
      border-bottom: var(--border-strong);
      border-right: var(--border-strong);
    }
  }
</style>
