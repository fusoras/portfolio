---
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<theme-toggle data-button="checkbox">
  <button data-theme-toggle aria-label={locate.THEME_TOGGLE_ARIA}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
    >
      <path
        class="sun"
        fill-rule="evenodd"
        d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
      ></path>
      <path
        class="moon"
        fill-rule="evenodd"
        d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
      ></path>
    </svg>
  </button>
</theme-toggle>

<style is:global>
  html[data-theme='dark'] {
    --toggle-sun: transparent;
    --toggle-moon: #fff;
  }

  html[data-theme='light'] {
    --toggle-sun: #000;
    --toggle-moon: transparent;
  }

  .sun {
    fill: var(--toggle-sun);
  }

  .moon {
    fill: var(--toggle-moon);
  }
</style>
<style>
  theme-toggle {
    width: 24px;
    height: 24px;
  }

  [data-theme-toggle] {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    transition: scale var(--duration-base) ease-in-out;

    &:active {
      scale: 0.9;
    }

    & svg {
      --size: 100%;

      width: var(--size);
      height: var(--size);
    }
  }
</style>

<script>
  class ThemeToggle extends HTMLElement {
    $root = document.documentElement
    buttonType = this.dataset.button

    connectedCallback() {
      this.init()
    }

    init() {
      if (this.buttonType === 'checkbox') {
        this.addEventListener('click', ev => {
          const $target = ev.target instanceof Element ? ev.target : null
          const $themeToggle = $target?.closest('[data-theme-toggle]')
          if ($themeToggle instanceof HTMLElement) {
            this.handleToggleClick()
          }
        })
      }

      if (this.buttonType === 'menu') {
        const saveTheme = localStorage.getItem('theme')
        const $select = this.querySelector('[data-select]')

        if (!($select instanceof HTMLSelectElement)) return

        if (saveTheme === 'dark' || saveTheme === 'light') {
          $select.value = saveTheme
        }
        $select.addEventListener('change', ev => {
          if (!(ev.target instanceof HTMLSelectElement)) return
          const currentValue = ev.target.value
          this.$root.dataset.theme = currentValue
          localStorage.setItem('theme', currentValue)
        })
      }
    }
    handleToggleClick() {
      const nextTheme = this.$root.dataset.theme === 'dark' ? 'light' : 'dark'

      const switchTheme = () => {
        this.$root.dataset.theme = nextTheme
        localStorage.setItem('theme', nextTheme)
      }

      if (!document.startViewTransition) {
        switchTheme()
        return
      }

      document.startViewTransition(switchTheme)
    }
  }

  customElements.define('theme-toggle', ThemeToggle)
</script>
