---
import { ROUTES } from '@/config.ts'
const { currentLocale } = Astro
const { title = 'FuSoraS', description = '', lang = 'es_ES' } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, ROUTES.HOSTNAME).toString()
const author = 'FuSoraS'
const ogImage = `${ROUTES.HOSTNAME}/og.png`
const ogImageAlt = 'FuSoraS — portafolio de desarrollador web frontend'
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${ROUTES.HOSTNAME}/`} />
    <link rel="alternate" hreflang="en" href={`${ROUTES.HOSTNAME}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${ROUTES.HOSTNAME}/`} />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/favicon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link
      rel="icon"
      href="/favicon-192x192.png"
      type="image/png"
      sizes="192x192"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta
      name="google-site-verification"
      content="l0My55aihzJm_JtopsqJ5AvG-_KkYURzqQy3B03_UUE"
    />

    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <meta name="author" content={author} />
    <meta
      name="theme-color"
      content="#1a1a1a"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={author} />
    <meta name="twitter:site" content={author} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="FuSoraS" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'FuSoraS',
        url: ROUTES.HOSTNAME,
        jobTitle: 'Developer',
        sameAs: [`${ROUTES.REPOSITORY}`, `${ROUTES.LINKEDIN}`],
      })}
    />
    <script is:inline>
      const currentTheme = globalThis.matchMedia(
        '(prefers-color-scheme: light)',
      ).matches
        ? 'light'
        : 'dark'
      const tt = localStorage.getItem('theme')
      const nextTheme = tt === 'dark' || tt === 'light' ? tt : currentTheme
      document.documentElement.dataset.theme = nextTheme
      if (tt !== 'dark' && tt !== 'light') {
        localStorage.removeItem('theme')
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @custom-media --mobile (width <= 700px);

  :root {
    /* COLORS */
    --accent: var(--clrp-accent, #30c06c);
    --accent-dark: hsl(from var(--accent) h s calc(l - 10));
    --accent-secondary: hsl(313.88deg 60.2% 39.41%);
    --fg: #fff;
    --bg: #100f0f;
    --muted: #ffffff0d;
    --border: color-mix(var(--fg), var(--muted));

    /* ===== FONTS ===== */
    --sans: ui-sans-serif, system-ui, sans-serif;
    --text-sm: 0.875rem;
    --text-md: 1rem;
    --text-xl: 1.5rem;
    --text-2xl: 2rem; 
    --text-3xl: 2.5rem;

    @media (--mobile) {
      --text-xl: 1.2rem;
      --text-2xl: 1.5rem;
      --text-3xl: 2rem;
    }

    /* RADII (Rounded corners) */
    --radius-card: 16px;
    --radius-tile: 12px;
    --radius-control: 8px;

    /* ===== SPACING (Padding / Margin / Gap) ===== */
    --space-sm: 0.65rem; 
    --space-md: 1rem;
    --space-lg: 1.25rem;
    --space-xl: 1.5rem;
    --space-2xl: 2rem;

    /* SIZES */
    --icon-sm: 1.1rem;
    --icon-md: 1.5rem;

    color-scheme: light dark;
    font-family: var(--sans);
  }

  html {
    display: flex;
    place-content: center;
    scroll-behavior: smooth;
    color: var(--fg);
    background-color: var(--bg);

    @media (prefers-reduced-motion: reduce) {
      scroll-behavior: auto;
    }

    &[data-theme='dark'] {
      color-scheme: dark;
    }

    &[data-theme='light'] {
      --accent: var(--clrp-accent, hsl(144.83deg 55.24% 41.18%));
      --accent-secondary: hsl(302.88deg 63.45% 38.63%);
      --bg: #fffcf0;
      --fg: #000;
      --muted: #0000000d;

      color-scheme: light;
    }
  }

  body {
    margin: 0;
    padding: clamp(16px, 8vw, 32px);
    width: min(700px, 90%);
    border-inline: 1px solid var(--muted);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  h2 {
    font-size: var(--text-2xl);
    font-weight: bold;
    margin-bottom: var(--space-lg);
    color: var(--fg);
  }

  h3 {
    font-size: var(--text-xl);
    font-weight: bold;
  }

  strong {
    color: var(--accent);
  }

  a {
    color: var(--fg);
    text-decoration: none;
  }

  p {
    text-wrap: pretty;
    font-size: var(--text-md);
  }

  ::view-transition-group(root) {
    animation-duration: 0.5s;
  }

  ::view-transition-new(root) {
    animation-name: reveal-light;
    animation-fill-mode: both;
  }

  ::view-transition-old(root),
  .dark::view-transition-old(root) {
    animation: none;
    animation-fill-mode: both;
    z-index: -1;
  }

  .dark::view-transition-new(root) {
    animation-name: reveal-dark;
    animation-fill-mode: both;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(root),
    ::view-transition-new(root),
    ::view-transition-old(root) {
      animation: none;
      animation-fill-mode: both;
    }
  }

  @keyframes reveal-dark {
    from {
      clip-path: polygon(50% -71%, -50% 71%, -50% 71%, 50% -71%);
    }

    to {
      clip-path: polygon(50% -71%, -50% 71%, 50% 171%, 171% 50%);
    }
  }

  @keyframes reveal-light {
    from {
      clip-path: polygon(171% 50%, 50% 171%, 50% 171%, 171% 50%);
    }

    to {
      clip-path: polygon(171% 50%, 50% 171%, -50% 71%, 50% -71%);
    }
  }
</style>
<script>
  import { $, $$ } from '@/lib/dom'

  const $sections = $$('section')
  const $navLinks = $$('nav a')

  globalThis.addEventListener(
    'scroll',
    () => {
      $sections.forEach($sect => {
        const top = globalThis.scrollY
        const offset = $sect.offsetTop
        const height = $sect.offsetHeight
        const id = $sect.getAttribute('id')

        if (top >= offset && top < offset + height) {
          $navLinks.forEach($links => {
            $links.classList.remove('active')
            const $activeLink = $(`nav a[href*=${id}]`)
            if ($activeLink) {
              $activeLink.classList.add('active')
            }
          })
        }
      })
    },
    { passive: true },
  )
</script>
