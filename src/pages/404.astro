---
import Layout from '@/layouts/Layout.astro'
import { getI18N } from '@/i18n/index.ts'

const { currentLocale } = Astro
const locate = getI18N({ currentLocale })
---

<Layout
  title={locate.ERROR_404_TITLE}
  description={locate.ERROR_404_DESCRIPTION}
>
  <div>
    <h1>{locate.ERROR_404_HEADING}</h1>
    <p>{locate.ERROR_404_TEXT}</p>
    <a href="/">{locate.ERROR_404_HOME_LINK}</a>
  </div>
</Layout>

<style>
  body {
    padding-block: 0;
  }

  div {
    display: flex;
    place-content: center;
    place-items: center;
    flex-direction: column;
    height: 100vh;
  }

  h1 {
    text-align: center;
  }

  a {
    background-color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-tile);
    padding: var(--space-sm) var(--space-md);

    &:active {
      background-color: var(--border);
    }
  }
</style>
